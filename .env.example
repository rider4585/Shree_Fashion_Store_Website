# Public (client-side) Convex URL. Override with your cloud deployment URL
# (e.g. https://<deployment>.convex.cloud) for production builds.
VITE_CONVEX_URL=http://127.0.0.1:3210

# Server-side (Convex backend) values — set in the deployment's environment.
# - JWKS / JWT_PRIVATE_KEY / SITE_URL for the auth stack
# - AUTH_EMAIL_FROM and AUTH_EMAIL_WEBHOOK_URL to deliver OTP emails
CONVEX_DEPLOYMENT=